{
  "manifest_version": 3,
  "name": "BrowserMCP — AI Browser Control Bridge",
  "version": "1.0.0",
  "description": "Universal local AI browser control layer connecting ChatGPT, Claude, and MCP agents with Google Chrome.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "BrowserMCP Status"
  },
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": true
  }
}
